#!name=Apple Internal Asset Redirect
#!desc=改写 InternalBuild 触发的内部资产域名，并拦截已废弃的 APNs 网关。
#!category=Apple

[Rule]
DOMAIN,gateway.push.apple.com,REJECT

[Script]
# 内部资产域名 -> 公网域名
http-request ^https?:\/\/(basejumper|gdmf-staging-int)\.apple\.com\/ script-path=https://raw.githubusercontent.com/sekiranunn/script/main/apple_systemapp_asset.js, requires-body=false, timeout=30, tag=AppleInternalAsset

[MITM]
hostname = basejumper.apple.com, gdmf-staging-int.apple.com
